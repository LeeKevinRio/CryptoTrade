# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Telegram Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Web Dashboard 認證
# 對 POST /api/.../actions/* 端點需要在 Header 帶 X-Auth-Token
# 若未設定，啟動時會印出隨機 token（每次重啟不同，建議自己設一個固定值）
WEB_AUTH_TOKEN=

# TradingView webhook 專用 token（未設定時退回使用 WEB_AUTH_TOKEN）
WEBHOOK_TOKEN=

# 啟動時從幣安回補最近 N 天的成交紀錄到績效資料庫（0 = 關閉）。
# 資料庫歸零、本地/雲端切換後，績效統計都能自動接續；重複執行會去重。
IMPORT_EXCHANGE_TRADES_DAYS=30

# 觀察模式：true 時完整顯示行情/持倉/績效，但保證不送出任何訂單。
# 本地開介面、雲端引擎交易時務必開啟 —— 兩台全功能引擎會對同一帳戶重複下單
TRADING_DISABLED=false

# 公網部署模式：true 時「整個」儀表板（含 GET 頁面與 WebSocket）都要 token，
# 瀏覽器開 https://你的網址/?token=<WEB_AUTH_TOKEN> 通過一次後種 cookie。
# 部署到 Render/Fly 等公開網址務必開啟；本機或 SSH 隧道可維持 false。
DASHBOARD_AUTH=false
