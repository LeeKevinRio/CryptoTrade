# ============================================================
#  真金設定（run_live.bat 專用）—— 複製為 .env.live 後填入
#  這個檔案只放「真金」金鑰；測試網金鑰留在 .env，兩者永不混用。
# ============================================================

# 幣安「正式站」API（API 管理 → 只勾「啟用合約」、不勾提幣、IP 限制填你家的 IP）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 選填：Telegram 通知（每筆開倉／平倉推到手機）。不用就留空。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 啟動時從幣安回補最近 N 天成交到績效資料庫
IMPORT_EXCHANGE_TRADES_DAYS=30
